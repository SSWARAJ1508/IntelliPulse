# Artifact models:
# Ignore large experimental models (>10MB), but explicitly preserve the frozen production XGBoost model
artifacts/models/*.joblib
artifacts/models/*.pkl
!artifacts/models/churn_xgboost_v4_tuned.joblib

# Ephemeral test/upload batches (preserve preset scenarios batch_001_stable, batch_002_mild_shift, batch_003_strong_shift)
artifacts/monitoring/incoming_batches/batch_[0-9a-f]*.csv
data/raw/*.xls
